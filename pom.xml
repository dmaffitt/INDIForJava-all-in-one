<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <artifactId>i4j</artifactId>
    <groupId>org.indilib.i4j</groupId>
    <version>2.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>INDIForJava</name>
    <description>INDIForJava is a set of libraries to implement clients, drivers and servers that follow the INDI
        distributed control protocol, a protocol designed to operate astronomical instrumentation.
    </description>
    <url>https://indiforjava.github.io/</url>
    <organization>
        <name>INDIForJava</name>
    </organization>
    <scm>
        <connection>scm:git:https://github.com/INDIForJava/INDIForJava.git</connection>
        <developerConnection>scm:git:https://github.com/INDIForJava/INDIForJava.git</developerConnection>
        <url>https://github.com/INDIForJava/INDIForJava/tree/main</url>
    </scm>
    <inceptionYear>2012</inceptionYear>
